# Copy to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (https://neon.tech → your project → "Pooled connection").
DATABASE_URL=

# Admin login for /admin.
ADMIN_USERNAME=
# bcrypt hash of the admin password — generate with:
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('your-password', 12))"
# IMPORTANT: Next.js expands "$VAR" references in .env files, so escape every "$"
# in the hash as "\$" (e.g. \$2b\$12\$...) or the value will be corrupted.
ADMIN_PASSWORD_HASH=

# Random secret for signing the admin session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
